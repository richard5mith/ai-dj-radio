# Required
OPENAI_API_KEY=your_openai_api_key_here

# Optional: only needed if any DJ uses voice_provider="elevenlabs"
ELEVENLABS_API_KEY=

# Optional: only needed if any DJ uses voice_provider="gemini"
GEMINI_API_KEY=

# Required for weather DJ talk (OpenWeatherMap One Call 3.0 key from
# https://openweathermap.org/api — the free tier is enough)
WEATHER_API_KEY=your_weather_api_key_here

# Location and timezone settings (also configurable in config/station.json)
WEATHER_LOCATION=London,UK
TIMEZONE=Europe/London

# Optional: override the playlist URL the web UI advertises. Leave empty to
# use the URL returned by the radio-server's /api/station endpoint.
# RADIO_STREAM_URL=https://your-cdn.example.com/audio/live.m3u8

# Optional: password-protected stream proxy (Caddy, port 8090 by default).
# Uncomment COMPOSE_PROFILES to start it with the rest of the stack.
# COMPOSE_PROFILES=streams
# Generate the password hash with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
CADDY_STREAMS_PORT=8090
CADDY_STREAM_USER=listener
CADDY_STREAM_PASS_HASH=your_bcrypt_hash_here
